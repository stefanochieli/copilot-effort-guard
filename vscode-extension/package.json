{
  "name": "copilot-effort-guard-status",
  "displayName": "Copilot Effort Guard",
  "description": "Colour bar and side panel showing how hard the GitHub Copilot model is struggling, with advice: raise thinking, upgrade the model, or downgrade when the task is easy.",
  "version": "0.10.0",
  "publisher": "stefanochieli",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanochieli/copilot-effort-guard.git",
    "directory": "vscode-extension"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node ../scripts/bundle-hooks.mjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "effortGuard.showReport",
        "title": "Effort Guard: Show report"
      },
      {
        "command": "effortGuard.reset",
        "title": "Effort Guard: Reset after changing model or thinking"
      },
      {
        "command": "effortGuard.installHooks",
        "title": "Effort Guard: Install or update the Copilot hooks"
      },
      {
        "command": "effortGuard.setThresholds",
        "title": "Effort Guard: Set thresholds for this project"
      },
      {
        "command": "effortGuard.exportCsv",
        "title": "Effort Guard: Export history as CSV"
      },
      {
        "command": "effortGuard.voteUp",
        "title": "Effort Guard: The last result was good"
      },
      {
        "command": "effortGuard.voteDown",
        "title": "Effort Guard: The last result was bad"
      }
    ],
    "configuration": {
      "title": "Copilot Effort Guard",
      "properties": {
        "effortGuard.copilotHome": {
          "type": "string",
          "default": "",
          "description": "Copilot home folder (the one that contains effort-guard/). Empty: COPILOT_HOME or ~/.copilot."
        },
        "effortGuard.threshold": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Fallback threshold, used only if the hook state does not record one (it normally does)."
        },
        "effortGuard.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when the warning threshold is reached."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "effortGuard",
          "title": "Effort Guard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "effortGuard": [
        {
          "type": "webview",
          "id": "effortGuard.panel",
          "name": "Effort"
        }
      ]
    }
  },
  "keywords": [
    "copilot",
    "github copilot",
    "effort",
    "thinking",
    "reasoning",
    "model",
    "agent",
    "hooks",
    "status bar"
  ]
}
