{
  "name": "copilot-effort-guard-status",
  "displayName": "Copilot Effort Guard",
  "description": "Status bar and side panel for copilot-effort-guard: a colour bar showing how hard the Copilot model is struggling.",
  "version": "0.4.0",
  "publisher": "stefanochieli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanochieli/copilot-effort-guard.git",
    "directory": "vscode-extension"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "effortGuard.showReport",
        "title": "Effort Guard: Show report"
      }
    ],
    "configuration": {
      "title": "Copilot Effort Guard",
      "properties": {
        "effortGuard.copilotHome": {
          "type": "string",
          "default": "",
          "description": "Copilot home folder (the one that contains effort-guard/). Empty: COPILOT_HOME or ~/.copilot."
        },
        "effortGuard.threshold": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Fallback threshold, used only if the hook state does not record one (it normally does)."
        },
        "effortGuard.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when the warning threshold is reached."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "effortGuard",
          "title": "Effort Guard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "effortGuard": [
        {
          "type": "webview",
          "id": "effortGuard.panel",
          "name": "Effort"
        }
      ]
    }
  }
}
